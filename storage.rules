rules_version = '2';

// Photos: anyone can view; only the owner can upload images under their own folder.
// CVs: signed-in members only. Banners: admins only.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isSmallImage() {
      return request.resource.size < 4 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /products/{uid}/{productId}/{file} {
      allow read: if true;
      allow create, update: if isOwner(uid) && isSmallImage();
      allow delete: if isOwner(uid);
    }

    match /avatars/{uid}/{file} {
      allow read: if true;
      allow create, update: if isOwner(uid) && isSmallImage();
      allow delete: if isOwner(uid);
    }

    // CVs (PDF / Word, max 5 MB). Only signed-in members can download them.
    match /cvs/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/(pdf|msword|vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document)');
      allow delete: if isOwner(uid);
    }

    // Rider photos and ID pictures (signed-in members only).
    match /riders/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isSmallImage();
      allow delete: if isOwner(uid);
    }

    // Home banners uploaded from the admin console.
    match /banners/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.admin == true && isSmallImage();
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
