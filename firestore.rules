rules_version = '2';

// JDMart security rules. The app can only do what is allowed here; orders,
// payments, stock and ratings are written by Cloud Functions (which bypass
// these rules), so prices and totals can't be tampered with from a phone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function validPhoneOrNull(v) { return v == null || (v is string && v.matches('^[+]232[0-9]{8}$')); }
    // Admins get the `admin` claim at sign-in (functions/src/admin.ts).
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // ---- Users ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if true; // public profile only — private data lives in /private

      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'city', 'bio', 'avatarUrl', 'contactPhone', 'verified',
                                                 'ratingAvg', 'ratingCount', 'salesCount', 'createdAt'])
        && str(request.resource.data.name, 2, 60)
        && str(request.resource.data.city, 2, 40)
        && validPhoneOrNull(request.resource.data.contactPhone)
        && request.resource.data.verified == false
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.salesCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if (isUser(uid)
        && changed().hasOnly(['name', 'city', 'bio', 'avatarUrl', 'contactPhone'])
        && str(request.resource.data.name, 2, 60)
        && str(request.resource.data.bio, 0, 200)
        && validPhoneOrNull(request.resource.data.contactPhone)
      ) || (
        isAdmin() && changed().hasOnly(['verified']) && request.resource.data.verified is bool
      );

      allow delete: if false; // use the deleteAccount function

      match /private/{doc} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if isUser(uid);
      }
      match /wishlist/{productId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && request.resource.data.keys().hasOnly(['createdAt']);
      }
      match /purchases/{productId} {
        allow read: if isUser(uid);
        allow write: if false; // written when an order is delivered
      }
    }

    // ---- Products --------------------------------------------------------------
    function validProduct(d) {
      return str(d.title, 4, 80)
        && str(d.description, 10, 2000)
        && d.price is number && d.price > 0 && d.price <= 10000000
        && (d.oldPrice == null || (d.oldPrice is number && d.oldPrice > d.price))
        && d.discountPercent is int && d.discountPercent >= 0 && d.discountPercent < 100
        && d.stock is int && d.stock >= 0 && d.stock <= 10000
        && d.images is list && d.images.size() >= 1 && d.images.size() <= 6
        && d.keywords is list && d.keywords.size() <= 200
        && d.negotiable is bool
        && d.categoryId in ['phones', 'electronics', 'fashion', 'home', 'groceries', 'beauty',
                            'vehicles', 'property', 'agric', 'kids', 'sports', 'other']
        && d.condition in ['New', 'Used', 'Refurbished']
        && str(d.city, 2, 40);
    }

    match /products/{productId} {
      allow read: if resource.data.status != 'hidden'
        || (signedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();

      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly([
             'title', 'description', 'price', 'oldPrice', 'discountPercent', 'categoryId', 'condition', 'city',
             'stock', 'negotiable', 'images', 'keywords', 'sellerId', 'sellerName', 'sellerVerified', 'status',
             'featured', 'views', 'ratingAvg', 'ratingCount', 'createdAt', 'updatedAt'])
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerName == userDoc(request.auth.uid).name
        && request.resource.data.sellerVerified == userDoc(request.auth.uid).verified
        && validProduct(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.featured == false
        && request.resource.data.views == 0
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if (
          signedIn() && resource.data.sellerId == request.auth.uid
          && changed().hasOnly(['title', 'description', 'price', 'oldPrice', 'discountPercent', 'categoryId',
                                'condition', 'city', 'stock', 'negotiable', 'images', 'keywords', 'status', 'updatedAt'])
          && validProduct(request.resource.data)
          && request.resource.data.status in ['active', 'sold', 'hidden']
        ) || (
          // anyone signed in may add one view
          signedIn() && changed().hasOnly(['views']) && request.resource.data.views == resource.data.views + 1
        ) || (
          // admins: feature, hide or restore any listing
          isAdmin() && changed().hasOnly(['status', 'featured'])
          && request.resource.data.status in ['active', 'sold', 'hidden']
          && request.resource.data.featured is bool
        );

      allow delete: if (signedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();

      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if isUser(uid)
          && exists(/databases/$(database)/documents/users/$(uid)/purchases/$(productId))
          && request.resource.data.keys().hasOnly(['userName', 'rating', 'comment', 'createdAt'])
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && str(request.resource.data.comment, 0, 500)
          && str(request.resource.data.userName, 1, 60)
          && request.resource.data.createdAt == request.time;
        allow delete: if isUser(uid);
      }
    }

    // ---- Orders & payments (server-written) -------------------------------------
    match /orders/{orderId} {
      allow read: if (signedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid))
        || isAdmin();
      allow write: if false;
    }
    match /checkouts/{checkoutId} {
      allow read: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow write: if false;
    }
    match /sellerStats/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // ---- Chat ------------------------------------------------------------------------
    match /chats/{chatId} {
      // resource == null lets the app check whether a chat exists yet.
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if hasProfile()
        && request.resource.data.buyerId == request.auth.uid
        && chatId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.sellerId == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerId
        && request.resource.data.participants == [request.auth.uid, request.resource.data.sellerId];

      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && changed().hasOnly(['lastMessage', 'lastSenderId', 'lastAt', 'unread']);

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && str(request.resource.data.text, 1, 2000)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---- Admin-managed & safety ---------------------------------------------------
    match /emailCodes/{id} {
      allow read, write: if false; // sign-in codes, server only
    }
    match /banners/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && str(request.resource.data.title, 1, 80)
        && request.resource.data.active is bool
        && request.resource.data.order is int;
      allow delete: if isAdmin();
    }
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['productId', 'reporterId', 'reason', 'status', 'createdAt'])
        && str(request.resource.data.reason, 2, 200);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && changed().hasOnly(['status']);
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false; // adminSetRole function (super admin only)
    }

    // ---- Jobs ---------------------------------------------------------------------------
    function jobCategory(v) {
      return v in ['sales', 'it', 'education', 'health', 'hospitality', 'construction', 'driving',
                   'finance', 'ngo', 'agric', 'domestic', 'media', 'security', 'other'];
    }
    function validJob(d) {
      return str(d.title, 4, 80)
        && str(d.company, 2, 80)
        && str(d.description, 20, 4000)
        && jobCategory(d.categoryId)
        && d.type in ['Full-time', 'Part-time', 'Contract', 'Internship', 'Temporary', 'Volunteer']
        && str(d.city, 2, 40)
        && str(d.salary, 0, 60)
        && str(d.contactEmail, 0, 100)
        && validPhoneOrNull(d.contactPhone)
        && d.keywords is list && d.keywords.size() <= 200;
    }

    match /jobs/{jobId} {
      allow read: if resource.data.status != 'hidden'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly([
             'title', 'company', 'description', 'categoryId', 'type', 'city', 'salary', 'contactEmail',
             'contactPhone', 'keywords', 'ownerId', 'ownerName', 'status', 'applicationsCount', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == userDoc(request.auth.uid).name
        && request.resource.data.status == 'open'
        && request.resource.data.applicationsCount == 0
        && request.resource.data.createdAt == request.time
        && validJob(request.resource.data);

      allow update: if (
          signedIn() && resource.data.ownerId == request.auth.uid
          && changed().hasOnly(['title', 'company', 'description', 'categoryId', 'type', 'city', 'salary',
                                'contactEmail', 'contactPhone', 'keywords', 'status', 'updatedAt'])
          && validJob(request.resource.data)
          && (
            (resource.data.status != 'hidden' && request.resource.data.status in ['open', 'closed'])
            || (resource.data.status == 'hidden' && request.resource.data.status == 'hidden')
          )
        ) || (
          isAdmin() && changed().hasOnly(['status'])
          && request.resource.data.status in ['open', 'closed', 'hidden']
        );

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // One application per person: the document id is the applicant's uid.
      match /applications/{applicantId} {
        allow read: if isUser(applicantId)
          || (signedIn() && resource.data.ownerId == request.auth.uid)
          || isAdmin();

        allow create: if isUser(applicantId) && hasProfile()
          && request.resource.data.keys().hasOnly([
               'jobId', 'jobTitle', 'company', 'ownerId', 'applicantId', 'applicantName', 'phone', 'email',
               'message', 'cvUrl', 'cvName', 'status', 'createdAt'])
          && request.resource.data.applicantId == applicantId
          && request.resource.data.jobId == jobId
          && request.resource.data.ownerId == get(/databases/$(database)/documents/jobs/$(jobId)).data.ownerId
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'open'
          && request.resource.data.ownerId != applicantId
          && request.resource.data.status == 'new'
          && str(request.resource.data.applicantName, 1, 60)
          && str(request.resource.data.phone, 0, 20)
          && str(request.resource.data.email, 0, 100)
          && str(request.resource.data.message, 0, 1500)
          && (request.resource.data.cvUrl == null || str(request.resource.data.cvUrl, 1, 2000))
          && (request.resource.data.cvName == null || str(request.resource.data.cvName, 1, 200))
          && request.resource.data.createdAt == request.time;

        // The employer can shortlist / decline.
        allow update: if signedIn() && resource.data.ownerId == request.auth.uid
          && changed().hasOnly(['status'])
          && request.resource.data.status in ['new', 'shortlisted', 'rejected'];

        allow delete: if isUser(applicantId) || isAdmin();
      }
    }

    // "My applications" (collection group query by applicantId).
    match /{path=**}/applications/{appId} {
      allow read: if signedIn()
        && (resource.data.applicantId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---- Delivery tracking -----------------------------------------------------------------
    // Created by the openDelivery function. Buyer, seller and the rider (who joined with the
    // code) can read it, and each may only write their own live location.
    match /deliveries/{orderId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && changed().hasOnly(['locations'])
        && request.resource.data.locations.diff(resource.data.locations).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.locations)
            || (request.resource.data.locations[request.auth.uid].lat is number
                && request.resource.data.locations[request.auth.uid].lng is number));
      allow create, delete: if false;

      // The buyer's handover PIN.
      match /secrets/{doc} {
        allow read: if signedIn() && resource.data.buyerId == request.auth.uid;
        allow write: if false;
      }
    }

    // ---- Talent profiles (CVs) ---------------------------------------------------------------
    function validTalent(d) {
      return str(d.name, 2, 60)
        && str(d.headline, 4, 80)
        && jobCategory(d.categoryId)
        && str(d.city, 2, 40)
        && d.skills is list && d.skills.size() <= 20
        && str(d.summary, 0, 3000)
        && d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 60
        && str(d.education, 0, 1000)
        && validPhoneOrNull(d.phone)
        && str(d.email, 0, 100)
        && (d.cvUrl == null || str(d.cvUrl, 1, 2000))
        && (d.cvName == null || str(d.cvName, 1, 200))
        && (d.photoUrl == null || d.photoUrl is string)
        && d.openToWork is bool
        && d.visible is bool
        && d.keywords is list && d.keywords.size() <= 200;
    }

    match /talent/{uid} {
      // Contact details: signed-in members only.
      allow read: if signedIn() && (resource.data.visible == true || isUser(uid) || isAdmin());

      allow create: if isUser(uid) && hasProfile()
        && request.resource.data.keys().hasOnly([
             'name', 'headline', 'categoryId', 'city', 'skills', 'summary', 'experienceYears', 'education',
             'phone', 'email', 'cvUrl', 'cvName', 'photoUrl', 'openToWork', 'visible', 'keywords',
             'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && validTalent(request.resource.data);

      allow update: if isUser(uid)
        && request.resource.data.keys().hasOnly([
             'name', 'headline', 'categoryId', 'city', 'skills', 'summary', 'experienceYears', 'education',
             'phone', 'email', 'cvUrl', 'cvName', 'photoUrl', 'openToWork', 'visible', 'keywords',
             'createdAt', 'updatedAt'])
        && !changed().hasAny(['createdAt'])
        && validTalent(request.resource.data);

      allow delete: if isUser(uid) || isAdmin();
    }
  }
}
